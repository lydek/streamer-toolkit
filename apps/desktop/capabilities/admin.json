{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "admin-dev",
  "description": "Admin window in dev (local origin through devUrl). Release builds create a remote capability for the bound port at runtime instead.",
  "windows": ["admin"],
  "permissions": [
    "allow-get-admin-token",
    "allow-open-twitch-activate",
    "allow-open-twitch-chat",
    "allow-open-logs-folder",
    "allow-close-hint",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
