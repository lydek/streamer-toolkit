{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Streamer Toolkit",
  "version": "0.1.0",
  "identifier": "app.streamertoolkit.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web/dist-port",
    "beforeDevCommand": { "script": "pnpm --filter web dev", "cwd": "../.." },
    "beforeBuildCommand": { "script": "pnpm --filter web build", "cwd": "../.." }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
