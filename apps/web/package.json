    "test": "vitest run",
    "lint": "eslint .",
    "api:types": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@primeuix/themes": "2.0.3",
    "@tauri-apps/api": "^2.12.4",
    "openapi-fetch": "^0.17.0",
    "primeicons": "7.0.0",
    "primevue": "4.5.5",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
