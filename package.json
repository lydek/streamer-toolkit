{
  "name": "streamer-toolkit",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "lefthook install",
    "tauri": "tauri",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "check:translations": "node scripts/check-translations.mjs",
    "web:lint": "pnpm --filter web lint",
    "web:test": "pnpm --filter web test",
    "api:gen": "cargo run -q -p host --example openapi -- apps/web/src/api/openapi.json && pnpm --filter web api:types"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "lefthook": "^2.2.2"
  }
}
