{
  "name": "streamer-toolkit",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "lefthook install",
    "tauri": "tauri",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "check:translations": "node scripts/check-translations.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "licenses:gen": "node scripts/third-party-licenses.mjs",
    "web:lint": "pnpm --filter web lint",
    "web:test": "pnpm --filter web test",
    "web:e2e": "pnpm --filter web e2e",
    "api:gen": "cargo run -q -p host --example openapi -- apps/web/src/api/openapi.json && pnpm --filter web api:types",
    "dev:fake": "node scripts/dev-fake.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "lefthook": "^2.2.2"
  }
}
